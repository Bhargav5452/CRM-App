<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      On Android 15+ (API 35+), the OS enforces edge-to-edge regardless of
      the base theme. We override it here by setting optOutEdgeToEdge = true,
      which keeps the pre-35 behaviour of NOT drawing under the status bar.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:datePickerDialogTheme">@style/AppCompatDatePickerDialogTheme</item>
        <item name="android:timePickerDialogTheme">@style/AppCompatDatePickerDialogTheme</item>
    </style>
</resources>
