<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      Main app theme: no action bar, solid white status bar with dark icons.
      The window background matches the app's bg-main (#FAFAFA) so that
      any brief moment before the WebView paints shows the correct colour
      rather than black or system grey.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Match app background to prevent black/grey flash when WebView loads -->
        <item name="android:windowBackground">@color/app_background</item>
        <!-- Solid white status bar -->
        <item name="android:statusBarColor">#FFFFFF</item>
        <!-- Dark icons (time, wifi, battery) on white status bar -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- Do NOT draw under the status bar -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:fitsSystemWindows">false</item>
        <!-- Configure explicit Date & Time Picker Dialog Themes for WebView HTML5 inputs -->
        <item name="android:datePickerDialogTheme">@style/AppCompatDatePickerDialogTheme</item>
        <item name="android:timePickerDialogTheme">@style/AppCompatDatePickerDialogTheme</item>
    </style>

    <!-- Dedicated Light Dialog Theme for DatePickerDialog launched by WebView -->
    <style name="AppCompatDatePickerDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">#09090B</item>
        <item name="android:colorAccent">#09090B</item>
    </style>

    <!--
      Launch / splash theme: shown before MainActivity.onCreate() runs.
      Uses the splash drawable as the window background (instant, no delay).
      Status bar is white with dark icons to match the app header.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Keep status bar solid white during splash -->
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

</resources>